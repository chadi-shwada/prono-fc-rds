# ==========================================================================
#  Prono FC RDS — variables de production
#  Copie ce fichier en « .env » sur le serveur et remplis les valeurs.
#  (docker compose lit automatiquement le fichier .env du dossier)
# ==========================================================================

# Ton nom de domaine (sans https://). Le DNS doit pointer vers l'IP du serveur.
DOMAIN=pronofcrds.fr

# URL publique complète (utilisée pour les liens de partage / Open Graph)
NEXT_PUBLIC_SITE_URL=https://pronofcrds.fr

# Clé de l'API foot (résultats automatiques) — https://www.football-data.org/
FOOTBALL_API_KEY=remplace_par_ta_cle

# Secrets — génère-les avec :  openssl rand -hex 32
APP_SECRET=remplace_par_un_secret_aleatoire
CRON_SECRET=remplace_par_un_autre_secret_aleatoire

# Compte admin et code d'invitation créés au premier démarrage
SEED_ADMIN_NAME=chadi
SEED_INVITE_CODE=RDS2026

# Fréquence de synchro des résultats, en secondes (défaut 120 = scores en
# quasi direct). Tu peux augmenter hors tournoi (ex. 600) pour ménager l'API.
SYNC_INTERVAL_SECONDS=120

# Notifications push (rappels avant match + résultats).
# Génère la paire de clés avec :  npx web-push generate-vapid-keys
# Laisse vide pour désactiver les notifications (le bouton n'apparaîtra pas).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tonadresse@exemple.fr

# ==========================================================================
#  Instance DISCORD (2e accès sur le MÊME VPS) — laisse tout VIDE pour la RATP.
#  Pour l'activer : remplis ci-dessous + décommente COMPOSE_PROFILES, puis crée
#  caddy-conf.d/discord.caddy (voir DISCORD.md). Sinon, la RATP tourne seule.
# ==========================================================================
# Active la 2e instance (décommente une fois tout prêt) :
# COMPOSE_PROFILES=discord

# (Sous-)domaine de l'instance Discord (DNS → IP du VPS)
DISCORD_SITE_URL=https://discord.tondomaine.fr

# Secrets propres à l'instance Discord (génère-les : openssl rand -hex 32)
DISCORD_APP_SECRET=
DISCORD_CRON_SECRET=

# Admin de l'instance Discord : mets ton ID utilisateur Discord (numérique).
# Active le « Mode développeur » dans Discord (Paramètres → Avancés), puis
# clic droit sur ton profil → « Copier l'identifiant ». Ton compte est promu
# admin automatiquement à la connexion. (Si renseigné, aucun compte admin par
# nom n'est créé — ça évite le compte « fantôme » qui réapparaît au redémarrage.)
DISCORD_ADMIN_ID=

# Code d'invitation de l'instance Discord (le login se fait via Discord, ce code
# n'est utilisé que pour l'éventuelle connexion pseudo + code de secours).
DISCORD_SEED_INVITE_CODE=DISCORD2026

# Connexion via Discord : appli sur https://discord.com/developers/applications
# (OAuth2 → Redirect : https://discord.tondomaine.fr/api/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Annonces : webhook d'un salon (Paramètres du salon → Intégrations → Webhooks)
DISCORD_WEBHOOK_URL=

# (Optionnel) push pour l'instance Discord : NOUVELLE paire VAPID
DISCORD_VAPID_PUBLIC_KEY=
DISCORD_VAPID_PRIVATE_KEY=
DISCORD_VAPID_SUBJECT=mailto:tonadresse@exemple.fr
