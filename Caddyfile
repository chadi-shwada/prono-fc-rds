# Caddy obtient et renouvelle automatiquement le certificat HTTPS (Let's Encrypt)
# pour ton domaine. Il suffit que le DNS du domaine pointe vers l'IP du serveur
# et que les ports 80 et 443 soient ouverts.

{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# Sites additionnels (ex. instance Discord). Le glob n'échoue pas s'il n'y a
# aucun fichier — l'instance RATP fonctionne seule par défaut.
import /etc/caddy/conf.d/*.caddy
